# ===================================================================
# KONFIGURASI LINGKUNGAN PRODUKSI (PRODUCTION ENVIRONMENT VARIABLES)
# Aplikasi: Project Management
# ===================================================================

# Domain Publik Aplikasi
NEXT_PUBLIC_APP_URL=https://project-management.domainanda.id

# -------------------------------------------------------------------
# Clerk Authentication (Production Keys)
# Dapatkan dari: https://dashboard.clerk.com/
# -------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret_here
INITIAL_ADMIN_EMAIL=admin@projectku.id

# -------------------------------------------------------------------
# Basis Data Neon PostgreSQL (Production Connection String)
# Dapatkan dari: https://console.neon.tech/
# -------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-production-instance.region.aws.neon.tech/neondb?sslmode=require

# -------------------------------------------------------------------
# Kunci Enkripsi Kredensial Server Proyek
# Kunci rahasia 32 bytes / 64 karakter hex acak
# Buat via terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -------------------------------------------------------------------
CREDENTIAL_ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# -------------------------------------------------------------------
# Bunny CDN (Pengiriman Aset Statis & Media Publik - Opsional)
# -------------------------------------------------------------------
NEXT_PUBLIC_CDN_URL=https://projectmanagement-cdn.b-cdn.net
BUNNY_API_KEY=
BUNNY_STORAGE_ZONE=

# -------------------------------------------------------------------
# Integrasi GitHub REST API (Read-Only)
# Personal Access Token (PAT) GitHub dengan scope read-only repository
# -------------------------------------------------------------------
GITHUB_TOKEN=your_github_personal_access_token_here
